                prefs[KEY_BG_TYPE]               = s.bgType.name
                prefs[KEY_GRADIENT_DIRECTION]    = s.gradientDirection.name
            }
            TickAtWidgetReceiver.updateAll(context, s)
        }
    }

    fun reset() = save(AppSettings())
}
