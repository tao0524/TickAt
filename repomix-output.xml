        SizeAdjustDialog(
            title        = "日付のサイズ",
            previewDraft = draft.copy(clockDateBalance = tempBalance),
            tasks        = tasks,
            canPlus      = tempBalance < 10,
            canMinus     = tempBalance > -10,
            onPlus       = { tempBalance = (tempBalance + 1).coerceIn(-10, 10) },
            onMinus      = { tempBalance = (tempBalance - 1).coerceIn(-10, 10) },
