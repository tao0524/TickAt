                                                horizontalArrangement = Arrangement.SpaceBetween
                                            ) {
                                                Text(symbol, color = MaterialTheme.colorScheme.primary, fontSize = 13.sp, fontWeight = FontWeight.Medium, modifier = Modifier.weight(0.8f))
