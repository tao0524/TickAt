            }
            Spacer(Modifier.height(4.dp))
            Text("変更後", color = MaterialTheme.colorScheme.onSurfaceVariant, fontSize = 10.sp)
        }
    }
}

/** HEX入力行（previewAlpha対応） */
@Composable
private fun HexInputRow(
