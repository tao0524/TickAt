                                // テンプレートモード
                                val now = java.util.Date()
                                val templates = listOf(
                                    "" to "なし（非表示）",
                                    "MM/dd" to "",
                                    "dd/MM" to "",
                                    "M月 d" to "",
                                    "M月 d日" to "",
                                    "M/d" to "",
                                    "EEE" to "",
                                    "EEE, MM/dd" to "",
                                    "EEE, dd/MM" to "",
                                    "EEE, M月 d" to "",
                                    "EEE, M月 d日" to "",
                                    "MM/dd (EEE)" to "",
                                    "M月 d日 (EEE)" to "",
                                    "EEE, MM/dd/yyyy" to "",
                                    "EEE, M月 d, yyyy" to "",
                                    "yyyy/MM/dd" to "",
                                    "yyyy/MM/dd (EEE)" to "",
                                    "EEEE, M月 d日" to ""
                                )

